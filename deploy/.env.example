# Copied to deploy/.env on the server. Feeds both docker compose's own
# variable substitution (${SANDBOX_DOMAIN}, ${POSTGRES_PASSWORD}) and the
# api container's environment (env_file).

SANDBOX_DOMAIN=sync-sandbox.example.com
POSTGRES_PASSWORD=change-me

PORT=8080
DATABASE_URL=postgres://postgres:change-me@postgres:5432/pamphlet_sync?sslmode=disable
GIN_MODE=release
FRONTEND_URL=https://sandbox.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://sync-sandbox.example.com/auth/google/callback
