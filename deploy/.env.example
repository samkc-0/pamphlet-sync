# Copied to deploy/.env on the server. Feeds both docker compose's own
# variable substitution (${POSTGRES_PASSWORD}) and the api container's
# environment (env_file). Routing/TLS is handled by the shared Caddy
# stack on the appnet Docker network, not by this repo.

POSTGRES_PASSWORD=change-me

PORT=8080
DATABASE_URL=postgres://postgres:change-me@postgres:5432/pamphlet_sync?sslmode=disable
GIN_MODE=release
FRONTEND_URL=https://pamphlet-sandbox.netlify.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://pamphlet-sync.pug.homes/auth/google/callback
